@inproceedings{elango2022,
  title = {Harmonic {{Analysis}} on {{Axial Turbine Blades}}},
  booktitle = {Recent {{Advances}} in {{Computational}} and {{Experimental Mechanics}}, {{Vol}}---{{I}}},
  author = {Elango, Murugappan and Annamalai, Adithyan and \textbf{S. T. Paruchuri}},
  editor = {Maity, D. and Patra, P. K. and Afzal, M.S. and Ghoshal, R. and Mistry, C. S. and Jana, P. and Maiti, D. K.},
  year = {2022},
  pages = {23--35},
  publisher = {Springer Singapore},
  address = {Singapore},
  abstract = {Composites serve as a go-to material in today's aerospace engines proving to be an implicit successor to the typical metals and alloys. Till date, modal analysis and harmonic analysis have been given lesser importance when compared to the study of mechanical behavior of materials. The modal analysis gives the mode frequency of the given structure. Harmonic analysis helps in analyzing the external frequency applied to make the material resonate at the mode natural frequency unarguably responsible for the failure of the structure. Henceforth, this work concentrates on the harmonic analysis of alloyed and composite turbine blades subjected to cyclic loading using finite element technique. The objective of our work is to perform harmonic analysis on alloy turbine blades and composite turbine blades of varying fiber orientations and compare their vibration stability for different excitation frequencies.},
  copyright = {All rights reserved},
  isbn = {978-981-16-6738-1},
  keywords = {abstract,LU,refereed,STP}
}

